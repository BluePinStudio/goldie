{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "activity": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['lastUsedAt', 'loginsLast7Days', 'loginsLast31Days', 'jobBagsInspected'])",
        "lastUsedAt": {
          ".validate": "newData.isNumber()"
        },
        "lastRecordedLogin": {
          ".validate": "newData.isString()"
        },
        "loginsLast7Days": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "loginsLast31Days": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "jobBagsInspected": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "loginEvents": {
          "$eventId": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "days": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && (root.child('members').child(auth.uid).child('role').val() === 'editor' || root.child('members').child(auth.uid).child('role').val() === 'viewer')",
      "$date": {
        "bags": {
          ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'editor'",
          "$bagId": {
            ".validate": "newData.hasChildren(['id', 'reference', 'type', 'createdAt', 'createdByUid', 'createdByName', 'tasks', 'total']) && newData.child('id').val() === $bagId && (!data.exists() || newData.child('createdByUid').val() === auth.uid) && (!newData.child('deleted').exists() || newData.child('deleted').isBoolean()) && newData.child('createdAt').isNumber() && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('createdByName').isString() && (newData.child('type').val() === 'ring' || newData.child('type').val() === 'necklace' || newData.child('type').val() === 'custom')"
          }
        }
      }
    }
  }
}
