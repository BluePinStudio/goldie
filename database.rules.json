{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "activity": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['lastUsedAt', 'loginsLast7Days', 'loginsLast31Days', 'jobBagsInspected'])",
        "lastUsedAt": {
          ".validate": "newData.isNumber()"
        },
        "lastRecordedLogin": {
          ".validate": "newData.isString()"
        },
        "loginsLast7Days": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "loginsLast31Days": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "jobBagsInspected": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "loginEvents": {
          "$eventId": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "activityDetails": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "inspectedJobBags": {
          "$date": {
            "$jobId": {
              ".validate": "newData.hasChildren(['reference', 'lastInspectedAt'])",
              "reference": {
                ".validate": "newData.isString()"
              },
              "lastInspectedAt": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          }
        },
        "calendarDaysViewed": {
          "$date": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "days": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && (root.child('members').child(auth.uid).child('role').val() === 'editor' || root.child('members').child(auth.uid).child('role').val() === 'viewer')",
      "$date": {
        "bags": {
          ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'editor'",
          "$bagId": {
            ".validate": "newData.hasChildren(['id', 'reference', 'type', 'createdAt', 'createdByUid', 'createdByName', 'tasks', 'total']) && newData.child('id').val() === $bagId && (!data.exists() || newData.child('createdByUid').val() === auth.uid) && (!newData.child('deleted').exists() || newData.child('deleted').isBoolean()) && newData.child('createdAt').isNumber() && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('createdByName').isString() && (newData.child('type').val() === 'ring' || newData.child('type').val() === 'necklace' || newData.child('type').val() === 'custom') && ((data.exists() && !data.child('repairTimeMinutes').exists()) || (newData.child('repairTimeMinutes').isNumber() && newData.child('repairTimeMinutes').val() >= 1 && newData.child('repairTimeMinutes').val() % 1 === 0)) && ((data.exists() && !data.child('itemNumber').exists()) || (newData.child('itemNumber').isNumber() && newData.child('itemNumber').val() >= 1 && newData.child('itemNumber').val() % 1 === 0))",
            "repairTimeMinutes": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
            },
            "itemNumber": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
            }
          }
        }
      }
    }
  }
}
