{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "activity": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['lastUsedAt', 'loginsLast7Days', 'loginsLast31Days', 'jobBagsInspected'])",
        "lastUsedAt": {
          ".validate": "newData.isNumber()"
        },
        "lastRecordedLogin": {
          ".validate": "newData.isString()"
        },
        "loginsLast7Days": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "loginsLast31Days": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "jobBagsInspected": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "loginEvents": {
          "$eventId": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "activityDetails": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "inspectedJobBags": {
          "$date": {
            "$jobId": {
              ".validate": "newData.hasChildren(['reference', 'lastInspectedAt'])",
              "reference": {
                ".validate": "newData.isString()"
              },
              "lastInspectedAt": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          }
        },
        "calendarDaysViewed": {
          "$date": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "days": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && (root.child('members').child(auth.uid).child('role').val() === 'editor' || root.child('members').child(auth.uid).child('role').val() === 'viewer')",
      "$date": {
        "bags": {
          "$bagId": {
            ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'editor'",
            ".validate": "newData.hasChildren(['id', 'reference', 'type', 'createdAt', 'createdByUid', 'createdByName', 'total']) && newData.child('id').val() === $bagId && newData.child('reference').isString() && newData.child('createdAt').isNumber() && newData.child('createdByUid').isString() && ((!data.exists() && newData.child('createdByUid').val() === auth.uid) || (data.exists() && newData.child('createdByUid').val() === data.child('createdByUid').val())) && newData.child('createdByName').isString() && newData.child('total').isNumber() && newData.child('total').val() >= 0 && (newData.child('type').val() === 'ring' || newData.child('type').val() === 'necklace' || newData.child('type').val() === 'bracelet' || newData.child('type').val() === 'watch' || newData.child('type').val() === 'custom') && (newData.child('type').val() === 'custom' || newData.child('tasks').hasChildren()) && (!newData.child('deleted').exists() || newData.child('deleted').isBoolean())",
            "repairTimeMinutes": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
            },
            "itemNumber": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
            },
            "noJobBag": {
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    }
  }
}
